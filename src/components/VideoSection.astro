---
// TODO(Founder/W1): the source file (54MB) is too large to commit as a static asset —
// upload "HOLOSYNTHICS ONE.mp4" to YouTube as UNLISTED, then replace YOUTUBE_VIDEO_ID below
// with the resulting video ID. Thumbnail already extracted from "HOLOSYNTHICS ONE-Cover.jpg".
const YOUTUBE_VIDEO_ID = 'REPLACE_WITH_YOUTUBE_ID';
const VIDEO_TITLE = 'Holosynthics — The Periodic Table of AI Model Health';
const VIDEO_DESCRIPTION =
  'An introduction to Holosynthics: the 56-element periodic table of digital matter, and how Probe56 scans, diagnoses, and repairs AI models without retraining.';
const UPLOAD_DATE = '2026-07-07';
const THUMBNAIL_URL = '/img/holosynthics-one-cover.jpg';

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: VIDEO_TITLE,
  description: VIDEO_DESCRIPTION,
  thumbnailUrl: `https://holosynthics.com${THUMBNAIL_URL}`,
  uploadDate: UPLOAD_DATE,
  embedUrl: `https://www.youtube-nocookie.com/embed/${YOUTUBE_VIDEO_ID}`,
  publisher: {
    '@type': 'Organization',
    name: 'Growing Intelligence',
    url: 'https://holosynthics.com',
  },
};
---

<section class="video-section" aria-label={VIDEO_TITLE}>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <div class="container">
    <h2>{VIDEO_TITLE}</h2>
    <p class="video-desc">{VIDEO_DESCRIPTION}</p>

    <div class="video-frame-wrap">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_VIDEO_ID}?autoplay=1&mute=1&loop=1&playlist=${YOUTUBE_VIDEO_ID}&controls=1&modestbranding=1&rel=0`}
        title={VIDEO_TITLE}
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
      <noscript>
        <img src={THUMBNAIL_URL} alt={VIDEO_TITLE} width="1280" height="720" />
      </noscript>
    </div>

    <details class="transcript">
      <summary>Video transcript</summary>
      <!-- TODO(Founder): replace with the real transcript once available — no speech-to-text
           tool was available to generate one from the source file during this build. -->
      <p class="transcript-pending">Transcript coming soon.</p>
    </details>
  </div>
</section>

<style>
  .video-section {
    padding: 100px 24px;
  }

  .container { max-width: 900px; margin: 0 auto; text-align: center; }

  h2 {
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 16px;
  }

  .video-desc {
    font-size: 16px;
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto 36px;
  }

  .video-frame-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }

  .video-frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .transcript {
    text-align: left;
    margin-top: 24px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .transcript summary {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
  }

  .transcript-pending {
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
  }
</style>
